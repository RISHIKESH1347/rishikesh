#include<stdio.h>
int main()
{
    int i,j,pos,element,n;
    scanf("%d",&n);
    int a[n];
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    printf("enter the position");
    scanf("%d",&pos);
    printf("enter the element");
    scanf("%d",&element);
    if(pos>n){
        printf("not possible");
    }
    for(i=0;i<n;i++){
        for(j=n-1;j>=pos-1;j--){
            a[i]=a[i+1];
            a[i]=element;
        }
        n++;
    }
    for(i=0;i<n;i++){
        printf("%d",a[i]);
    }
}
