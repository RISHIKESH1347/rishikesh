#include <stdio.h>
int main()
{
    int n, i, j, count = 1;
    scanf("%d", &n);
    int arr[n];
    for(i = 0; i < n; i++){
        scanf("%d", &arr[i]);
    }
    for(i=0;i<n;i++){
        if(arr[i]!=-999){
            count=1;
        for(j=i+1;j<n;j++){
            if(arr[i]==arr[j]&&arr[j]!=-999){
                count++;
                arr[j]=-999;
            }
        }
          printf("%d->%d\n",arr[i],count);  
        }
    }
    return 0;
}
